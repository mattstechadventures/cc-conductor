<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.conductor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>--import</string>
        <string>tsx</string>
        <string>src/index.ts</string>
